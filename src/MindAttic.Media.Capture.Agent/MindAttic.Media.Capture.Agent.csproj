<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>capture</AssemblyName>
    <!-- AgentLocator only trusts a capture.exe carrying this product name. -->
    <Product>MindAttic.Media.Capture.Agent</Product>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Media.Capture.Windows\MindAttic.Media.Capture.Windows.csproj" />
    <ProjectReference Include="..\MindAttic.Media.Capture.Sets\MindAttic.Media.Capture.Sets.csproj" />
    <ProjectReference Include="..\MindAttic.Media.Capture.Web\MindAttic.Media.Capture.Web.csproj" />
    <!-- agent.json lives under VaultPaths.LocalApp("Capture"), so MINDATTIC_VAULT_LOCAL_ROOT relocates it. -->
    <PackageReference Include="MindAttic.Vault" Version="8.0.0" />
    <!-- capture mcp: a stdio MCP server, pinned to the versions already used elsewhere (e.g. GridGame.Studio.Mcp). -->
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Media.Capture.Windows.Tests" />
  </ItemGroup>

</Project>
