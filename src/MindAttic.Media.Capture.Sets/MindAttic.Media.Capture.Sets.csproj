<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>MindAttic.Media.Capture.Sets</PackageId>
    <RootNamespace>MindAttic.Capture.Sets</RootNamespace>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <Description>Preview sets: one folder of numbered media plus preview.json (mindattic.preview/1) that agents write and MindAttic.MediaViewer shows. Store, media kinds and the viewer handoff.</Description>
    <PackageTags>capture;preview;media;viewer</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Media.Capture\MindAttic.Media.Capture.csproj" />
  </ItemGroup>

</Project>
