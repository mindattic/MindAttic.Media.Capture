<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>MindAttic.Media.Capture.Web</PackageId>
    <RootNamespace>MindAttic.Capture.Web</RootNamespace>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <Description>Headless web page screenshots and video through Playwright and the installed Microsoft Edge, with capture sidecars.</Description>
    <PackageTags>capture;screenshot;playwright;headless;web</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Media.Capture\MindAttic.Media.Capture.csproj" />
    <!-- Drives the installed Edge (channel msedge); no browser download. Pinned. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
  </ItemGroup>

</Project>
